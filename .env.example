# ── Site ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://mobehaviortherapy.com
NEXT_PUBLIC_COMPANY_PHONE=+13057950600
NEXT_PUBLIC_COMPANY_PHONE_DISPLAY=(305) 795-0600

# ── Lead notifications ───────────────────────────────────────────────────
COMPANY_NOTIFICATION_EMAIL=mobehavior@mobehaviortherapy.com
EMAIL_FROM_ADDRESS="MO Behavior Therapy <no-reply@mobehaviortherapy.com>"

# Email delivery — pick ONE provider and fill in its credentials.
# lib/email.ts reads EMAIL_PROVIDER to decide which client to use.
EMAIL_PROVIDER=smtp                # smtp | resend

# SMTP (e.g. Google Workspace, Microsoft 365, Postmark SMTP, SES SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Resend (https://resend.com) — used only if EMAIL_PROVIDER=resend
RESEND_API_KEY=

# ── Lead storage ─────────────────────────────────────────────────────────
# Local/dev default: leads are appended to ./data/leads.local.json (gitignored).
# Production: point Prisma at a real database (see prisma/schema.prisma) and
# set LEAD_STORE=prisma.
LEAD_STORE=file                    # file | prisma
DATABASE_URL="postgresql://user:password@host:5432/mo_behavior_therapy"

# ── Bot protection ───────────────────────────────────────────────────────
# Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile).
# Both fields must be set together — leave both blank to run with just the
# honeypot (app/api/leads|referrals|careers all handle this gracefully:
# the widget doesn't render client-side and the server skips verification).
# NEXT_PUBLIC_ prefix is required on the site key — it's read in the browser
# to render the widget; TURNSTILE_SECRET_KEY is server-only, never exposed.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── AI intake assistant (Milo) ───────────────────────────────────────────
# Optional. Without this key, Milo still works fully — it uses the built-in
# deterministic slot-filling + FAQ knowledge base (lib/chat/*). Adding a key
# lets it also answer more open-ended questions in natural language, always
# grounded to lib/chat/knowledgeBase.ts (see README "How the AI assistant works").
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ── Analytics (privacy-conscious; never send PHI) ────────────────────────
NEXT_PUBLIC_ANALYTICS_ID=

# ── Admin dashboard auth (see /admin, lib/adminAuth.ts, README section 8) ─
# All three are required together for /admin/login to work; the route
# returns "not configured yet" if any is missing rather than a confusing
# 401. ADMIN_PASSWORD_HASH is generated with lib/adminAuth.ts's
# hashPassword() — it is NOT the plaintext password. ADMIN_SESSION_SECRET
# is any long random string (used to HMAC-sign the session cookie).
ADMIN_USER=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
